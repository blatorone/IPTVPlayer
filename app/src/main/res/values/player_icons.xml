<?xml version="1.0" encoding="utf-8"?>
<!-- Play/pause in the same plain style as the other player buttons (Media3 draws a white circle
     around them otherwise). Deliberately overrides Media3's own icons, which its layout uses. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="UnusedResources">
    <drawable name="exo_styled_controls_play" tools:override="true">@drawable/ic_player_play</drawable>
    <drawable name="exo_styled_controls_pause" tools:override="true">@drawable/ic_player_pause</drawable>
</resources>
